# Copy to `.env` and fill in. Never commit the filled-in file.

# --- Database ---------------------------------------------------------------
# MongoDB connection string. Must be a replica set (Atlas is, by default):
# Prisma transactions, which order recording relies on, require one.
DATABASE_URL="mongodb+srv://user:password@cluster.mongodb.net/doni-shop"

# --- Site -------------------------------------------------------------------
# Public origin, no trailing slash. Used to build Stripe return URLs.
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Shown on the contact page as a mailto link. Optional: without it the page
# points visitors at the social accounts instead.
NEXT_PUBLIC_CONTACT_EMAIL=""

# --- Auth -------------------------------------------------------------------
# Signs session tokens. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
# Required in production; NextAuth infers it in development.
NEXTAUTH_URL="http://localhost:3000"

# --- Stripe -----------------------------------------------------------------
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# REQUIRED. Without it the webhook returns 500 and no paid order is ever
# recorded: the buyer is charged and nothing reaches the database.
#   Local:      stripe listen --forward-to localhost:3000/api/webhooks/stripe
#               (the CLI prints the whsec_... to use here)
#   Production: Stripe Dashboard → Developers → Webhooks → add an endpoint for
#               https://<your-domain>/api/webhooks/stripe listening to
#               `checkout.session.completed`, then copy its signing secret.
STRIPE_WEBHOOK_SECRET="whsec_..."

# --- Cloudinary -------------------------------------------------------------
# Server-side only. The browser uploads directly using a signature minted by
# /api/upload/signature, so these never reach the client.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
